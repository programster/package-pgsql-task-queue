{
    "name": "programster/pgsql-task-queue",
    "type": "library",
    "description": "A simple PostgreSQL task queue for PHP: tasks that can depend on each other, taken and run by any number of workers.",
    "keywords": ["pgsql", "postgresql", "queue", "task queue", "job queue", "worker"],
    "homepage": "https://github.com/programster/package-pgsql-task-queue",
    "license": "MIT",
    "authors": [
        {
            "name": "Stuart Page",
            "email": "sdpagent@gmail.com",
            "homepage": "https://blog.programster.org",
            "role": "Developer"
        }
    ],
    "require": {
        "ext-pgsql": "*",
        "php": "^8.2",
        "programster/collections": "^3.1",
        "programster/pgsql-lib": "^3.1",
        "psr/clock": "^1.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "ext-pcntl": "Lets a worker stop cleanly on SIGTERM and SIGINT, once it has finished the task it's on."
    },
    "autoload": {
        "psr-4": {
            "Programster\\PgsqlTaskQueue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Programster\\PgsqlTaskQueue\\Testing\\": "testing/"
        }
    }
}
